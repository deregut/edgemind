{
  "name": "edgemind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:api": "npm run dev -w server",
    "build": "npm run gen:migrations -w server && npm run build -w web && npm run build:functions",
    "build:functions": "node scripts/build-functions.mjs",
    "test": "npm run test -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web --noEmit",
    "db:generate": "npm run db:generate -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
