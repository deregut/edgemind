# 只有這 8 個值走環境變數；其餘設定都在網頁介面內完成並加密存入資料庫。
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/edgemind?sslmode=require
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=edgemind
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 48
JWT_SECRET=
