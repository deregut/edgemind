# EdgeMind 環境變數範本
# 只有資料庫、物件儲存與兩把金鑰走環境變數；LLM、搜尋、Embedding、MCP、Skills、權限等其餘設定
# 全部在網頁介面內完成，並以 ENCRYPTION_KEY 加密後存入資料庫。
# 本機開發：複製成 .env（已被 .gitignore 忽略），切勿把填好的檔案提交到 Git。

# ── 資料庫 ─────────────────────────────────────────────
# Neon（或任何已安裝 pgvector 的 Postgres）連線字串。Neon 主控台 → Connect 複製即可。
# 第一次啟動時會自動執行 migration（含 CREATE EXTENSION vector）。
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/edgemind?sslmode=require

# ── 物件儲存（任何 S3 相容服務：Neon Object Storage、Cloudflare R2、Backblaze B2、MinIO、AWS S3…）──
# 端點（不含 bucket 名稱）。例：
#   Cloudflare R2：https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Backblaze B2：https://s3.<region>.backblazeb2.com
#   AWS S3：     https://s3.<region>.amazonaws.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# 區域。R2 填 auto；B2／AWS 填實際區域（例：us-west-004、us-east-1）。
S3_REGION=auto
# Bucket 名稱（需事先建立；瀏覽器直傳所需的 CORS 會在第一次上傳時自動設定，權限不足時介面會顯示手動設定方式）。
S3_BUCKET=edgemind
# 存取金鑰（需有該 bucket 的讀寫權限；若要自動設定 CORS，還需 PutBucketCors 權限）。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 選填，預設 true：路徑式網址 {endpoint}/{bucket}/{key}（R2、B2、MinIO、Neon 都支援）。
# 只有服務僅接受虛擬主機式網址（{bucket}.{endpoint 主機}/{key}，例如部分 AWS 設定）時才改成 false。
S3_FORCE_PATH_STYLE=true

# ── 金鑰 ───────────────────────────────────────────────
# 加密所有 API Key、密鑰、MCP 憑證用的 32 位元組主金鑰（base64 或 64 個十六進位字元）。
# 產生：openssl rand -base64 32
#   或：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 部署後請勿更換，否則資料庫中已加密的值都無法解密（需在介面重新輸入）。
ENCRYPTION_KEY=
# 簽發登入 Cookie（JWT）與內部 HMAC 用的密鑰，至少 32 字元。
# 產生：openssl rand -base64 48
#   或：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# 更換後所有登入工作階段會失效（需重新登入），排程的 HMAC 簽章也會改變。
JWT_SECRET=
